import java.util.* ;
import java.io.*; 

public class Solution {

	public static int digitProduct(int n) {
		// Write your code here.
		ArrayList<Integer> res = new ArrayList<>();
		for(int i = 9; i >= 2; i--){
			while(n % i == 0){
				res.add(i);
				n = n/i;
			}
			
		}

		if(n > 1){
			return -1;
		}

		Collections.sort(res);
		int num = 0;
		for(int d : res){
			num = num * 10 + d;
		}
		return num;
		
	}

}

