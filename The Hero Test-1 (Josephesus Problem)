import java.util.* ;
import java.io.*; 
public class Solution {
	public static ArrayList<Integer> theOrder(int n) {
		// Write your code here.
		ArrayList<Integer> res = new ArrayList<>();
		boolean isSolve[] = new boolean[n+1];
		int cnt = 0;
		int indx = 1;

		while(cnt < n){
			while(isSolve[indx]){
				indx = (indx % n) + 1;
			}
			indx = (indx % n) + 1;

			while(isSolve[indx]){
				indx = (indx % n) + 1;
			}

			isSolve[indx] = true;
			res.add(indx);
			cnt++;
			indx = (indx % n) + 1;

		}
		return res;
		
	}
}

T.C => O(N ^ 2)
S.C => O(N)

