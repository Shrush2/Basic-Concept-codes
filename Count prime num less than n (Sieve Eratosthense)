class Solution {
    public int countPrimes(int n) {
   boolean isprime[] = new boolean[n];
   Arrays.fill(isprime,true);

   if(n <= 1){
    return 0;
   } 

   isprime[0] = false;
   isprime[1] = false;

   for(int i = 2;i*i < n;i++){
    if(isprime[i]){
        for(int j = i*i ;j<n;j +=i){
            isprime[j] = false;
        }
    }
   }   
int primecnt = 0;
for(boolean prime:isprime) {
    if(prime){
        primecnt++;
    }
}
return primecnt;
    }
}

T.C --> O(n log log n)
S.C -->O(n)
