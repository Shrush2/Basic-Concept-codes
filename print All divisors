class Solution {
    public static void print_divisors(int n) {
        ArrayList<Integer> ans = new ArrayList<>();
  for(int i=1 ;i <= Math.sqrt(n) ;i++){
      if((n% i) == 0){
          ans.add(i);
          
          if((n/i) != i){
         ans.add((n/i));
          }
      }
  }
  
  Collections.sort(ans);
  
  for(int div : ans){
      System.out.print(div +" ");
  }
    }
}

T.C -->O(sqrt(N)):
S.C --> O(N):
